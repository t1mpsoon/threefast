# ── Приложение ────────────────────────────────────────────────────────────────
APP_ENV=development                # development | production
APP_TITLE=ThreeFast

# ── База данных ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/express_pickup.db

# ── Безопасность ─────────────────────────────────────────────────────────────
# ВАЖНО: сгенерируйте свой ключ и НИКОГДА не коммитьте реальный .env
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_to_random_value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Бизнес-параметры по умолчанию ────────────────────────────────────────────
DEFAULT_SLOT_DURATION_MINUTES=5
DEFAULT_SLOT_CAPACITY=3
ORDER_EXPIRE_AFTER_READY_MINUTES=20
# Сколько дней вперёд можно бронировать слоты
MAX_BOOKING_DAYS_AHEAD=7

# ── Логирование ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs

# ── Защита от спама (раздел 2.14 ТЗ) ────────────────────────────────────────
RATE_LIMIT_ORDERS_PER_MINUTE=5

# ── Ограничения корзины (edge case раздела 2.15 ТЗ) ────────────────────────
MAX_QUANTITY_PER_ITEM=20
MAX_DISTINCT_ITEMS_PER_ORDER=15

# ── Начальные данные (создаются app/init_db) ────────────────────────────────
# Пароль администратора. Если пусто — генерируется случайно и печатается в консоль.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Пароль сотрудника кухни (staff). Если пусто — генерируется случайно.
SEED_STAFF_USERNAME=staff
SEED_STAFF_PASSWORD=
# Администратор сервиса: заводит заведения. Пароль — из SEED_ADMIN_PASSWORD.
SEED_SUPERADMIN=true
SEED_SUPERADMIN_USERNAME=superadmin

# ── Планировщик (правило Б-3: авто-истечение заказов) ──────────────────────
ENABLE_SCHEDULER=true
# Создавать начальные данные при старте приложения (в тестах выключается)
SEED_ON_STARTUP=true
